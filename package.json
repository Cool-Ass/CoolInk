{
  "name": "coolink-tattoo-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:test:prepare": "node scripts/prepareTestDatabase.cjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:security:audit": "node scripts/auditTestDatabaseSecurity.cjs",
    "db:security:verify": "node scripts/verifyTestRls.cjs",
    "db:security:http-verify": "node scripts/verifyTestHttpSecurity.cjs",
    "test:smoke:rls": "node scripts/verifyTestAppSmoke.cjs",
    "test:smoke:admin": "node scripts/verifyTestAdminSmoke.cjs",
    "test:smoke:client-fixture": "node scripts/verifyExistingTestClientSmoke.cjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.20.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.11.0",
    "gsap": "^3.12.5",
    "jose": "^5.9.6",
    "lenis": "^1.1.14",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.30",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
