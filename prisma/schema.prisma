// Prisma schema for the CoolInk CMS.
//
// The live CRM runs on Supabase PostgreSQL. DATABASE_URL is kept only in
// the local .env file and is never exposed to the browser.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  googleCalendarConnections GoogleCalendarConnection[]
}

/// CMS-authored pages, built from an ordered list of modules (see
/// lib/modules.ts) and rendered generically by <ModuleRenderer>.
///
/// `modules` is the working/draft copy — edited live in the page builder.
/// `publishedModules` is the last-published snapshot actually shown to
/// visitors, so draft edits never affect the live site until "Opublikuj".
/// `content` is kept only as a legacy fallback for pages created before
/// the modular builder existed (rendered as plain text if `modules` is
/// empty and the page has no published module snapshot either).
model Page {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  excerpt          String?
  content          String   @default("")
  coverImage       String?
  modules          String   @default("[]")
  publishedModules String?
  status           String   @default("draft") // "draft" | "published" | "unpublished"
  isHomepage       Boolean  @default(false)
  showInNav        Boolean  @default(true)
  navOrder         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Portfolio / gallery items shown on the public Portfolio section
model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?
  tags        String?  // comma-separated
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Uploaded media library, backing Page.coverImage / PortfolioItem.imageUrl,
/// module image fields, and anything else uploaded via /admin/media
model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  width     Int?
  height    Int?
  size      Int?
  mimeType  String?
  alt       String?
  createdAt DateTime @default(now())
}

/// Flat key/value store for GLOBAL site content only — things reused in
/// more than one place (branding, contact details, footer note). Page-
/// specific copy (hero heading, about text, etc.) lives in Page.modules
/// instead. See lib/content.ts for the full default shape.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Custom nav links (in addition to auto-included published Pages)
model NavItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Messages submitted through the public contact form. They are intentionally
/// kept separate from CMS content so the form works without a mail provider.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// CRM profile. Client login/authentication will be connected in the client-app phase;
/// it is intentionally separate from AdminUser so client data never shares admin access.
model Client {
  id          String          @id @default(cuid())
  supabaseUserId String?      @unique
  firstName   String
  lastName    String
  email       String          @unique
  phone       String?
  avatarUrl   String?
  birthDate   DateTime?
  notes       String?
  tags        String          @default("") // temporary CSV; normalized tags follow with staff roles
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  projects    TattooProject[]
  acceptances DocumentAcceptance[]
  notifications ClientNotification[]
}

/// Versioned studio documents: consent, preparation, aftercare and policies.
model StudioDocument {
  id          String               @id @default(cuid())
  title       String
  slug        String               @unique
  content     String
  category    String               @default("other") // consent | preparation | aftercare | policy | other
  version     Int                  @default(1)
  published   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  acceptances DocumentAcceptance[]
}

model DocumentAcceptance {
  id         String         @id @default(cuid())
  clientId   String
  documentId String
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  document   StudioDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  acceptedAt DateTime       @default(now())
  @@unique([clientId, documentId, version])
}

/// A tattoo brief is the central operational record. Appointments, deposits,
/// client messages and documents will attach to this entity in later phases.
model TattooProject {
  id                String         @id @default(cuid())
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String
  description       String
  styles            String         @default("")
  placement         String?
  size              String?
  colorPreference   String?
  estimatedPrice    Int?
  finalPrice        Int?
  status            String         @default("inquiry") // see lib/projectWorkflow.ts for the full, client-friendly workflow
  preferredDateNote String?
  internalNotes     String?
  depositStatus     String         @default("not_required") // not_required | awaiting | paid | refunded | forfeited
  depositAmount     Int?
  depositPaidAt     DateTime?
  depositPaymentMethod String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  images            ProjectImage[]
  appointments      Appointment[]
  activities        ProjectActivity[]
  messages          ProjectMessage[]
}

/// Appointments are kept separately from a project because a larger tattoo
/// can require several sessions. Availability blocks use the same time range model.
model Appointment {
  id          String        @id @default(cuid())
  projectId   String
  project     TattooProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  status      String        @default("requested") // requested | confirmed | deposit_required | deposit_paid | completed | cancelled | no_show
  notes       String?
  price       Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  googleCalendarSync GoogleCalendarEventSync?
}

/// Permanent, ordered history of meaningful actions taken on a tattoo project.
/// Internal events stay private; client-visible events may be surfaced in the portal.
model ProjectActivity {
  id        String        @id @default(cuid())
  projectId String
  project   TattooProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  message   String
  visibility String       @default("admin") // admin | client
  createdAt DateTime      @default(now())

  @@index([projectId, createdAt])
}

/// In-app delivery of business events. Future push and e-mail adapters can
/// consume the same event type without duplicating workflow logic.
model ClientNotification {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type          String
  title         String
  body          String
  href          String?
  projectId     String?
  appointmentId String?
  readAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([clientId, readAt, createdAt])
  @@index([projectId, createdAt])
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())
}

/// Repeating opening hours for the booking calendar. `weekday` follows JS:
/// 0 = Sunday, 1 = Monday … 6 = Saturday.
model WorkingHours {
  id        String   @id @default(cuid())
  weekday   Int      @unique
  enabled   Boolean  @default(true)
  startsAt  String   @default("10:00")
  endsAt    String   @default("19:00")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Explicit availability created by the studio. Unlike WorkingHours this is a
/// concrete, editable term and unlike AvailabilityBlock it never blocks time.
model AvailableSlot {
  id          String   @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  title       String?
  description String?
  color       String   @default("#10B981")
  icon        String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt, endsAt])
  @@index([isPublic, startsAt, endsAt])
}

/// A date-specific opening-hours exception. Weekly WorkingHours remains the
/// source of truth; this model is only used when one date needs different
/// hours or must be explicitly closed.
model WorkingHoursOverride {
  id         String   @id @default(cuid())
  date       DateTime @unique
  enabled    Boolean  @default(true)
  startsAt   String   @default("10:00")
  endsAt     String   @default("19:00")
  breakStart String?
  breakEnd   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Promotions can cover a single day or a complete date range. They are
/// deliberately independent from appointments so they can be safely shown
/// to the client without exposing any appointment data.
model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  badge       String?
  color       String   @default("#C99A4A")
  icon        String?
  promoCode   String?
  ctaLabel    String?
  ctaUrl      String?
  isPublic    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Internal or public calendar items which are not client appointments.
/// Labels stay on the event itself to avoid an extra lookup table until the
/// studio actually needs reusable event taxonomies.
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  color       String   @default("#6B7280")
  icon        String?
  label       String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  googleCalendarSync GoogleCalendarEventSync?

  @@index([startsAt, endsAt])
}

/// One explicit, administrator-owned Google Calendar consent. Tokens remain
/// encrypted and are used only by server-side sync code.
model GoogleCalendarConnection {
  id                    String   @id @default(cuid())
  adminUserId           String
  adminUser             AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  accountEmail          String?
  encryptedRefreshToken String
  tokenExpiresAt        DateTime?
  primaryCalendarId     String?
  syncToken             String?
  lastSyncedAt          DateTime?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  selections            GoogleCalendarSelection[]
  events                GoogleCalendarEventSync[]

  @@unique([adminUserId])
}

/// A primary read/write calendar or a read-only busy source chosen by admin.
model GoogleCalendarSelection {
  id           String   @id @default(cuid())
  connectionId String
  connection   GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  calendarId   String
  summary      String?
  role         String   @default("busy") // primary | busy
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([connectionId, calendarId])
  @@index([connectionId, role])
}

/// Stable idempotency record for one Google event. A row links either one
/// CoolInk appointment or one imported admin-only CalendarEvent, never data
/// exposed to clients/public Calendar APIs.
model GoogleCalendarEventSync {
  id                String   @id @default(cuid())
  connectionId      String
  connection        GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  googleCalendarId  String
  googleEventId     String
  appointmentId     String?  @unique
  appointment       Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  calendarEventId   String?  @unique
  calendarEvent     CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  googleUpdatedAt   DateTime?
  localFingerprint  String?
  lastSyncedAt      DateTime?
  syncStatus        String   @default("SYNCED") // SYNCED | PENDING_GOOGLE | PENDING_COOLINK | CONFLICT | ERROR | DELETED_REMOTE
  syncError         String?
  remoteDeletedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([googleCalendarId, googleEventId])
  @@index([connectionId, syncStatus])
}

model ProjectImage {
  id        String        @id @default(cuid())
  projectId String
  project   TattooProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  message   ProjectMessage? @relation("ProjectMessageAttachment")
}

/// Private conversation connected to one tattoo project. Messages are served
/// only by authenticated Next.js endpoints, never through the public Data API.
model ProjectMessage {
  id           String         @id @default(cuid())
  projectId    String
  project      TattooProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       String         // client | admin
  body         String         @default("")
  attachmentId String?        @unique
  attachment   ProjectImage?  @relation("ProjectMessageAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  readAt       DateTime?
  createdAt    DateTime       @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, author, readAt])
}
