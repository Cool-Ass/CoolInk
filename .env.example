# Emergency fallback for a fresh database. During normal operation use the
# switch in Admin -> Strony i builder; its saved value takes precedence.
SITE_BUILD_MODE=false

# Database and Supabase Auth
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Administrator bootstrap and session signing (32+ random characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SESSION_SECRET=
MAX_UPLOAD_MB=8

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vercel Cron authentication
CRON_SECRET=

# Durable media storage (Cloudflare R2, AWS S3 or compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Optional Google Calendar integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Google Places API (New) — public reviews widget
GOOGLE_PLACES_API_KEY=
