# Emergency fallback for a fresh database. During normal operation use the
# switch in Admin -> Strony i builder; its saved value takes precedence.
SITE_BUILD_MODE=false

# Database and Supabase Auth
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Wyłącznie po stronie serwera: usuwanie kont Auth i dostęp do starszych prywatnych plików.
SUPABASE_SERVICE_ROLE_KEY=

# Administrator bootstrap and session signing (32+ random characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
PRIVATE_MEDIA_SIGNING_KEY=
AUTOMATION_WEBHOOK_SECRET=
MAX_UPLOAD_MB=8
RETENTION_WEBHOOK_DAYS=90
RETENTION_READ_NOTIFICATION_DAYS=365
RETENTION_REMINDER_DELIVERY_DAYS=730

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vercel Cron authentication
CRON_SECRET=

# Durable media storage (Cloudflare R2, AWS S3 or compatible)
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Optional Google Calendar integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Rotation: newest key first, older keys after commas.
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEYS=
# CSP_MODE=report-only during observation; change to enforce after resolving reports.
CSP_MODE=report-only
# Google Places API (New) — public reviews widget
GOOGLE_PLACES_API_KEY=
